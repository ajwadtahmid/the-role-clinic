{
  "name": "the-role-clinic",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first job tracker and resume tailoring app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && node scripts/render-guide.mjs && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx apps/server/src/start-production.ts",
    "package:linux": "node scripts/build-package.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:check": "node --test scripts/desktop-target.checks.mjs",
    "desktop:collect": "node scripts/collect-desktop.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "2.12.4",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.15.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.14",
    "linkedom": "^0.18.14",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "6.5.438",
    "pdfmake": "^0.3.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar": "^7.5.22",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
