FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
# A package mirror sometimes serves a partial index, which shows up as "Unable to locate package". Retry, and
# make a partial index count as a failure instead of carrying on.
RUN for attempt in 1 2 3; do \
      apt-get update -o Acquire::Retries=5 -o APT::Update::Error-Mode=any && break; \
      echo "apt-get update failed (attempt $attempt)" >&2; sleep 15; \
    done \
    && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
    ca-certificates curl build-essential pkg-config libgtk-3-dev libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev librsvg2-dev libssl-dev patchelf file rpm libfuse2 \
    xvfb xauth dbus-x11 webkit2gtk-driver xdotool xclip imagemagick \
    && rm -rf /var/lib/apt/lists/*
ARG NODE_VERSION=24.18.1
RUN curl -fsSLO https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
    && curl -fsSLO https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt \
    && grep " node-v${NODE_VERSION}-linux-x64.tar.xz$" SHASUMS256.txt | sha256sum -c - \
    && mkdir -p /opt/node && tar -xJf node-v${NODE_VERSION}-linux-x64.tar.xz --strip-components=1 -C /opt/node \
    && rm node-v${NODE_VERSION}-linux-x64.tar.xz SHASUMS256.txt
ARG RUST_VERSION=1.99.1
ENV CARGO_HOME=/opt/rust/cargo RUSTUP_HOME=/opt/rust/rustup
RUN curl -fsSLo /tmp/rustup-init https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init \
    && curl -fsSLo /tmp/rustup-init.sha256 https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init.sha256 \
    && cd /tmp && sha256sum -c rustup-init.sha256 \
    && chmod +x rustup-init \
    && ./rustup-init -y --no-modify-path --profile minimal --default-toolchain ${RUST_VERSION} \
    && rm rustup-init rustup-init.sha256
ENV PATH=/opt/node/bin:/opt/rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /work
